# DBZS — Division By Zeros
# Diese Datei ist ausschließlich eine Vorlage. Keine echten Tokens eintragen oder committen.

# Basis-URL der lokalen oder im LAN erreichbaren Gitea-Instanz, ohne /api/v1.
GITEA_BASE_URL=http://127.0.0.1:3000

# Ausschließlich erlaubter Gitea-Benutzer- oder Organisationsnamespace.
GITEA_ALLOWED_OWNER=devdbzemusic

# Token wird NICHT in dieser Datei hinterlegt.
# Setzen Sie ihn im Windows-Prozesskontext, beispielsweise:
# $env:DBZS_HOME_API_TOKEN = "<persoenliches-gitea-token>"
# Der Server liest ausschließlich DBZS_HOME_API_TOKEN; GITEA_TOKEN bleibt nur ein kompatibler Legacy-Fallback.

# Optionaler lokaler MCP-Transport. Standard ist stdio; http bindet immer nur an 127.0.0.1.
MCP_TRANSPORT=stdio

# Optionaler TCP-Port für MCP_TRANSPORT=http; Standard ist 3939.
MCP_HTTP_PORT=3939

# DBZS — Division By Zeros
# Diese Datei ist ausschließlich eine Vorlage. Keine echten Tokens eintragen oder committen.

# Basis-URL der lokalen oder im LAN erreichbaren Gitea-Instanz, ohne /api/v1.
GITEA_BASE_URL=http://127.0.0.1:3000

# Ausschließlich erlaubter Gitea-Benutzer- oder Organisationsnamespace.
GITEA_ALLOWED_OWNER=devdbzemusic

# Token wird NICHT in dieser Datei hinterlegt.
# Setzen Sie ihn im Windows-Prozesskontext, beispielsweise:
# $env:DBZS_HOME_API_TOKEN = "<persoenliches-gitea-token>"
# Der Server liest ausschließlich DBZS_HOME_API_TOKEN; GITEA_TOKEN bleibt nur ein kompatibler Legacy-Fallback.

# Optionaler lokaler MCP-Transport. Standard ist stdio; http bindet immer nur an 127.0.0.1.
MCP_TRANSPORT=stdio

# Optionaler TCP-Port für MCP_TRANSPORT=http; Standard ist 3939.
MCP_HTTP_PORT=3939

# Optional: Signierter lokaler Gitea-Webhook. Beide Variablen müssen gemeinsam gesetzt sein.
# GITEA_WEBHOOK_SECRET muss mindestens 32 Zeichen haben und bleibt ausschließlich im Prozesskontext.
# GITEA_WEBHOOK_SECRET=<mindestens-32-zeichen-lokales-hmac-secret>
# GITEA_WEBHOOK_TARGET_URL=http://127.0.0.1:3939/webhooks/gitea

# Optional: bestehende lokale DBZS Fleet Commander v1 Control Plane. Nur HTTP-Loopback ist zulässig.
# DBZS_FLEET_API_URL=http://127.0.0.1:8110

# Optional: atomare Read-only-Plattformstatusdatei des bestehenden DBZS Feature Starters.
# DBZS_FEATURE_STARTER_HEALTH_PATH=C:\ProgramData\DBZS\CV5\platform-health.json

# Optional: bestehende DBZS Feature Starter CLI-Hooks. Der Pfad muss exakt auf DBZS.FeatureStarter.exe zeigen.
# DBZS_FEATURE_STARTER_EXECUTABLE=C:\Program Files\DBZS\DBZS.FeatureStarter.exe
# Nur die Zeichenfolge true erlaubt mutierende Update- und Installer-Hooks zusätzlich zu MCP confirm: true.
# DBZS_FEATURE_STARTER_ALLOW_HOOKS=false
